# Server
PORT=5000

# Required DB connection values (modify for your machine)
DB_HOST=localhost
DB_PORT=9100
DB_NAME=stockpro_db
DB_USER=stockpro
DB_PASSWORD=CHANGE_ME

# Optional pool tuning
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Auth
JWT_ISSUER=stockpro-api
JWT_AUDIENCE=stockpro-client
JWT_ACCESS_SECRET=CHANGE_ME_WITH_STRONG_RANDOM_SECRET
# Optional Google sign-in validation (must match frontend VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
# Optional default tenant company for registration when client does not send companyId
# Use either ID or slug.
DEFAULT_TENANT_COMPANY_ID=
DEFAULT_TENANT_COMPANY_SLUG=acme-logistics
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
JWT_SESSION_MAX_LIFETIME_SECONDS=2592000

# Auth rate limits
AUTH_RATE_LIMIT_LOGIN_WINDOW_MS=60000
AUTH_RATE_LIMIT_LOGIN_MAX=10
AUTH_RATE_LIMIT_REGISTER_WINDOW_MS=60000
AUTH_RATE_LIMIT_REGISTER_MAX=5
AUTH_RATE_LIMIT_REFRESH_WINDOW_MS=60000
AUTH_RATE_LIMIT_REFRESH_MAX=20

# Development helper: automatically activate signups (skip approval flow)
AUTO_APPROVE_SIGNUP=false

# PayPal billing (required for paid company-admin onboarding)
# Use sandbox credentials in development.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
# Optional override (usually leave empty)
PAYPAL_API_BASE_URL=
# Exchange rate used to convert MAD prices to USD for PayPal checkout.
# For example: 0.1 means 1 USD = 10 MAD. Defaults to 0.1 when not set.
PAYPAL_MAD_TO_USD_RATE=0.1

PAYPAL_FALLBACK_CURRENCY=USD

# Email delivery for password reset codes
# Use an SMTP app password, not your normal email password.
EMAIL_DELIVERY_MODE=SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=CHANGE_ME_WITH_SMTP_APP_PASSWORD
SMTP_FROM=StockPro Security <your-email@gmail.com>
